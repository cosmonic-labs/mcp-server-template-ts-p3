{
  "name": "mcp-off-shelf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Upstream TypeScript MCP SDK on WASI 0.3",
  "license": "Apache-2.0",
  "dependencies": {
    "@bytecodealliance/jco-std": "0.7.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@whatwg-node/node-fetch": "0.7.21",
    "abort-controller": "3.0.0",
    "web-streams-polyfill": "3.3.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@bytecodealliance/jco": "1.37.0",
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "24.9.2",
    "typescript": "7.0.2",
    "unenv": "2.0.0-rc.24",
    "yaml": "2.9.0"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/types.mjs && tsc --noEmit",
    "test": "node scripts/build.mjs --test && node --test test/component.test.mjs",
    "serve": "wasmtime serve -Scli -Shttp -Sp3 --addr 127.0.0.1:8080 dist/mcp.wasm",
    "test:boundary": "npm run build && node scripts/test-boundary.mjs",
    "test:outbound": "node scripts/build.mjs --test && node scripts/test-outbound.mjs",
    "build:compiler": "bash scripts/build-compiler.sh",
    "build:otel": "node scripts/build.mjs --otel",
    "test:all": "npm run check && node scripts/build.mjs --test --otel && node --test test/component.test.mjs test/manifests.test.mjs && node scripts/test-outbound.mjs && node scripts/test-boundary.mjs && node scripts/test-otel.mjs",
    "test:desktop": "node scripts/test-desktop.mjs"
  }
}
